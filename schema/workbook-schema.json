        ["registration_deadline_default", "2026-09-01", "DATE", "Registration deadline for all Chapters except Australasia.", "v1.0", null, null],
        ["registration_deadline_australasia", "2026-09-08", "DATE", "Registration deadline for the entire Australasia Chapter, including New Zealand.", "v1.0", null, null],
        ["verification_deadline", "2026-09-12", "DATE", "Chapter membership verification deadline.", "v1.0", null, null],
        ["max_timezone_spread_minutes", 180, "NUMBER", "Maximum time-zone spread across a triad.", "v1.0", null, null],
        ["min_shared_slot_minutes", 60, "NUMBER", "Minimum shared recurring meeting window.", "v1.0", null, null],
        ["minimum_month_coverage", 6, "NUMBER", "Number of programme months that must retain a common slot.", "v1.0", null, null],
        ["shortlist_size", 24, "NUMBER", "Maximum compatible peers considered per anchor participant.", "v1.0", null, null],
        ["restart_count", 24, "NUMBER", "Deterministic greedy restarts used by the matching engine.", "v1.0", null, null],
        ["weight_cross_chapter", 30, "NUMBER", "Soft-score weight for three different Chapters.", "v1.0", null, null],
        ["weight_credential", 20, "NUMBER", "Soft-score weight for similar credential levels.", "v1.0", null, null],
        ["weight_coaching_hours", 20, "NUMBER", "Soft-score weight for similar coaching-hour bands.", "v1.0", null, null],
        ["weight_availability", 15, "NUMBER", "Soft-score weight for additional common time slots.", "v1.0", null, null],
