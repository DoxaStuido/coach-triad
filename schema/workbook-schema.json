    {
      "name": "Form Responses 1",
      "purpose": "Append-only Google Form responses. Do not manually edit this sheet.",
      "capacityRows": 1000,
      "fields": [
        { "name": "Timestamp", "type": "DATETIME", "required": true, "editable": false, "description": "Google Form submission timestamp." },
        { "name": "Email Address", "type": "EMAIL", "required": true, "editable": false, "description": "Google account email captured by the form." },
        { "name": "Full Name (First name and Last name)", "type": "TEXT", "required": true, "editable": false, "description": "Participant name." },
        { "name": "What is your preferred email address?", "type": "EMAIL", "required": true, "editable": false, "description": "Primary deduplication key after normalization." },
        { "name": "Your ICF membership number", "type": "TEXT", "required": false, "editable": false, "description": "Self-reported ICF membership number." },
        { "name": "Membership expired date", "type": "DATE", "required": false, "editable": false, "description": "Self-reported membership expiry date." },
        { "name": "Which Chapter are you a member of?", "type": "TEXT", "required": true, "editable": false, "description": "Raw Chapter selection, including multi-Chapter answers." },
        { "name": "What is your most recent ICF credential?", "type": "TEXT", "required": true, "editable": false, "description": "Raw credential response." },
        { "name": "How many hours of coaching experience (paid or unpaid) do you have?", "type": "TEXT", "required": true, "editable": false, "description": "Raw coaching-hours band." },
        { "name": "What are your main areas of coaching practice? Select all that apply or add others. ", "type": "TEXT", "required": false, "editable": false, "description": "Practice areas retained for reference only." },
        { "name": "What time zone are you in?", "type": "TEXT", "required": true, "editable": false, "description": "Raw GMT selection; not sufficient for Australasia DST handling." },
        { "name": "Which days of the week are you available to meet for your coaching triad sessions? Select all that apply.", "type": "TEXT", "required": true, "editable": false, "description": "Raw local availability windows." },
        { "name": "What are your language preferences for participating in this program? E.g. \"English\", \"Bahasa Indonesia + English\"", "type": "TEXT", "required": true, "editable": false, "description": "Free-text language preferences." },
        { "name": "Would you be comfortable participating in triads where the common coaching language is English? ", "type": "TEXT", "required": true, "editable": false, "description": "English comfort and local-language-only requirement." },
        { "name": "Do you have any scheduling constraints? We will do our best to take these into consideration when placing you into a coaching triad.", "type": "TEXT", "required": true, "editable": false, "description": "Whether scheduling constraints exist." },
        { "name": "Please list any other scheduling constraints that you may have. We will do our best to take these into consideration when placing you into a coaching triad.", "type": "TEXT", "required": false, "editable": false, "description": "Free-text scheduling constraints." },
        { "name": "What do you wish to gain from participating in the Coach a Coach Programme?", "type": "TEXT", "required": false, "editable": false, "description": "Programme goals retained for reference." },
        { "name": " What coaching competencies or areas do you want to develop during this programme? ", "type": "TEXT", "required": false, "editable": false, "description": "Development goals retained for reference." },
        { "name": "Thank you for your commitment to your professional development as an ICF member Coach. Before submitting your expression of interest, please consider all other personal and professional commitments.", "type": "BOOLEAN_TEXT", "required": true, "editable": false, "description": "Commitment response." },
        { "name": "If you are a member of the ICF Australasia Chapter, please indicate whether you are based in Australia or New Zealand.", "type": "TEXT", "required": false, "editable": false, "description": "Partial residence hint; does not replace APAC residence verification." },
        { "name": "Column 19", "type": "TEXT", "required": false, "editable": false, "description": "Unused source column retained for source compatibility." }
      ]
    },
